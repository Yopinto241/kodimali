import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_design_system/flutter_design_system.dart';
import 'package:supabase_flutter/supabase_flutter.dart';
import 'package:customer_mobile/core/data/customer_account_repository.dart';
import 'package:customer_mobile/features/chat/listing_chat_screens.dart';
import 'package:customer_mobile/features/account/customer_account_screens.dart';
import '../apps/customer_mobile/test/mobile_ui_test.dart' show host;

// Temporary audit probes assert existing faulty behavior. These are not fixes
// or permanent tests that would require preserving the bug.
class AuditRepository extends CustomerAccountRepository {
  AuditRepository(super.client);
  String mode = '';
  final login = Completer<AuthResponse>();
  final messages = StreamController<List<Map<String, dynamic>>>.broadcast();
  @override
  Future<AuthResponse> signIn({required String email, required String password}) => login.future;
  @override
  Future<List<Map<String, dynamic>>> fetchListingChats() async {
    if (mode == 'raw') throw const PostgrestException(message: 'permission denied for table listing_conversations', code: '42501');
    await Future<void>.delayed(const Duration(seconds: 1));
    return [{'id':'chat','agent_name':'Fixture Agent','listing_title':'Fixture listing','expires_at':DateTime.now().add(const Duration(hours: 1)).toIso8601String()}];
  }
  @override
  Future<Map<String, dynamic>> fetchListingConversation(String id) async {
    if (mode == 'offline') throw StateError('Connection temporarily unavailable');
    return {'agent_name':'Fixture Agent','expires_at':DateTime.now().add(const Duration(hours: 1)).toIso8601String(),'messages_sent_today':0};
  }
  @override
  Stream<List<Map<String, dynamic>>> watchListingChatMessages(String id) => messages.stream;
  @override
  Future<void> markListingChatRead(String id) async {}
}

void main() {
  late SupabaseClient client;
  late AuditRepository repo;
  setUp(() {
    client=SupabaseClient('https://fixture.invalid','fixture',authOptions:const AuthClientOptions(autoRefreshToken:false));
    repo=AuditRepository(client);
  });
  tearDown(() async { await repo.messages.close(); await client.dispose(); });
  Future<void> open(WidgetTester tester, Widget screen) async {
    await tester.pumpWidget(host(screen,'en',KodimaliTheme.mobileLight(),1));
    await tester.pump();
  }
  testWidgets('CONFIRMED chat refresh raises a Flutter state-update error', (tester) async {
    await open(tester,CustomerListingChatsScreen(repository:repo));
    await tester.pump(const Duration(seconds:1)); await tester.pump();
    expect(find.text('Fixture listing',findRichText:true),findsNothing); // text is combined in subtitle
    expect(find.textContaining('Fixture listing'),findsOneWidget);
    await tester.pump(const Duration(seconds:4)); await tester.pump();
    expect(tester.takeException().toString(),contains('setState() callback argument returned a Future'));
    await tester.pumpWidget(const SizedBox()); await tester.pump(const Duration(seconds:1));
  });
  testWidgets('CONFIRMED raw backend details appear in chat error UI', (tester) async {
    repo.mode='raw';
    await open(tester,CustomerListingChatsScreen(repository:repo)); await tester.pump();
    expect(find.textContaining('permission denied for table listing_conversations'),findsOneWidget);
    await tester.pumpWidget(const SizedBox());
  });
  testWidgets('CONFIRMED failed access lookup is shown as expired paid chat', (tester) async {
    repo.mode='offline';
    await open(tester,CustomerListingChatScreen(repository:repo,conversationId:'chat')); await tester.pump();
    expect(find.text('Chat access expired'),findsOneWidget);
    expect(tester.widget<TextField>(find.byType(TextField)).enabled,isFalse);
    expect(find.textContaining('Connection temporarily unavailable'),findsNothing);
    await tester.pumpWidget(const SizedBox());
  });
  testWidgets('CONFIRMED incoming message pulls reader away from older messages', (tester) async {
    await open(tester,CustomerListingChatScreen(repository:repo,conversationId:'chat')); await tester.pump();
    final rows=List.generate(40,(i)=><String,dynamic>{'id':'$i','sender_id':'agent','body':'Message $i: ${'Long conversation text. '*8}','created_at':DateTime.now().toIso8601String()});
    repo.messages.add(rows); await tester.pump(); await tester.pump(const Duration(milliseconds:300));
    final scroll=tester.widget<ListView>(find.byType(ListView)).controller!;
    expect(scroll.position.maxScrollExtent,greaterThan(800));
    scroll.jumpTo(800);await tester.pump();expect(scroll.offset,800);
    repo.messages.add([...rows,{'id':'new','sender_id':'agent','body':'New message'}]);
    await tester.pumpAndSettle();
    expect(scroll.offset,0);
    await tester.pumpWidget(const SizedBox());
  });
  testWidgets('CONFIRMED slow login has no user-interface deadline', (tester) async {
    await open(tester,CustomerAuthScreen(repository:repo));
    await tester.enterText(find.byType(TextFormField).first,'fixture@example.invalid');
    await tester.enterText(find.byType(TextFormField).last,'test-password');
    await tester.ensureVisible(find.byType(FilledButton));await tester.tap(find.byType(FilledButton));await tester.pump();
    await tester.pump(const Duration(minutes:2));
    expect(tester.widget<FilledButton>(find.byType(FilledButton)).onPressed,isNull);
    expect(find.textContaining('try again'),findsNothing);
    await tester.pumpWidget(const SizedBox());repo.login.complete(AuthResponse());await tester.pump();
  });
}
